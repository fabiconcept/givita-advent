# --- Admin ---
# Password for the /admin dashboard. Defaults to "admin123" if unset (dev only).
ADMIN_PASSWORD=

# --- Google Sheets (database) ---
# ID of the Google Sheet that backs the form store. Tabs used: "Forms", "Responses".
GOOGLE_SHEET_ID=

# Either of the two below must be set for Google Sheets to be used.
# If neither is set, the app falls back to an in-memory store (dev only).

# Option A: paste the service account JSON directly.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Option B: path to the service account JSON file on disk.
GOOGLE_APPLICATION_CREDENTIALS=
