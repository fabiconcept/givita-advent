# --- Admin ---
# Password for the /admin dashboard. Defaults to "admin123" if unset (dev only).
ADMIN_PASSWORD=

# --- Google Sheets (database) ---
# ID of the Google Sheet that backs the form store. Tabs used: "Forms", "Responses".
GOOGLE_SHEET_ID=

# Service account credentials (individual env vars, no JSON file needed).
# Create a service account in Google Cloud, share the sheet with its email as Editor.
GOOGLE_SHEET_CLIENT_EMAIL=
GOOGLE_SHEET_PRIVATE_KEY=
# Optional fields (used to build the full credential object):
# GOOGLE_SHEET_PROJECT_ID=
# GOOGLE_SHEET_PRIVATE_KEY_ID=
# GOOGLE_SHEET_CLIENT_ID=
